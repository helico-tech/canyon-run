{
  "name": "canyon-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "description": "Fast, colourful first-person canyon flyer with deterministic replays",
  "scripts": {
    "dev": "pnpm build:wasm && vite",
    "build": "pnpm build:wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "lint": "eslint . --max-warnings 0 && pnpm lint:wasm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:wasm && vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "docs:validate": "node scripts/validate-docs.ts",
    "work:new": "node scripts/new-work-item.ts",
    "sim:validate": "node src/cli/replay.ts validate",
    "sim:run": "node src/cli/replay.ts run",
    "sim:regold": "node scripts/regold.ts",
    "headless:shot": "node tools/headless/shot.ts",
    "headless": "node tools/headless/run.ts",
    "headless:golden": "node tools/headless/golden.ts",
    "test:e2e": "pnpm build && playwright test",
    "issue": "node scripts/issues.ts",
    "adv:audit": "node tools/adversary-audit.ts",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path wasm/field/Cargo.toml && node scripts/copy-wasm.ts",
    "lint:wasm": "cargo fmt --check --manifest-path wasm/field/Cargo.toml && cargo clippy --release --target wasm32-unknown-unknown --manifest-path wasm/field/Cargo.toml -- -D warnings"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.185.4",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
